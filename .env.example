# Copie para .env.local e preencha. Valores do projeto remoto: Dashboard →
# Project Settings → API Keys. Valores do stack local: npx supabase status.
#
# Somente valores públicos. Nunca coloque aqui (nem em variáveis NEXT_PUBLIC_*)
# a secret key, a service_role key ou a senha do banco.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
