# Copie para .env.local e preencha. Valores do projeto remoto: Dashboard →
# Project Settings → API Keys. Valores do stack local: npx supabase status.
#
# Variáveis NEXT_PUBLIC_* chegam ao navegador: só valores públicos. Nunca
# coloque aqui a secret key, a service_role key ou a senha do banco.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor (Route Handlers de /api/books). Opcionais; ver
# docs/integracoes.md. Nunca use o prefixo NEXT_PUBLIC_ nestas variáveis.
#
# Chave de API do Google Books. Sem ela, a busca usa apenas o Open Library
# (sem chave, o Google Books responde 429).
GOOGLE_BOOKS_API_KEY=
# Contato (e-mail ou URL) enviado no User-Agent ao Open Library, como pede a
# política de uso da API.
BOOKS_API_CONTACT=
